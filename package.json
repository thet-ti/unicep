{
  "name": "unicep-monorepo",
  "private": true,
  "description": "Unified Brazilian CEP lookup with automatic provider fallback",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thet-ti/unicep.git"
  },
  "homepage": "https://unicep.thet.dev",
  "bugs": {
    "url": "https://github.com/thet-ti/unicep/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:package": "turbo run check:package",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.8",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "publint": "^0.3.25",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3"
  }
}
