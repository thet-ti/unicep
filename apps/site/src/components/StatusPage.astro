---
import Layout from '../layouts/Layout.astro';
import type { StatusSnapshot } from '../lib/status';
import { htmlLang, type Locale, messages, routes } from '../i18n/ui';

interface Props {
  locale: Locale;
  status: StatusSnapshot;
}

const { locale, status } = Astro.props;
const t = messages[locale].status;
const { providers, checkedAt } = status;

// Providers that were not probed (no API key configured) do not count towards the summary.
const checked = providers.filter((p) => p.checked);
const onlineCount = checked.filter((p) => p.online).length;
const summary =
  onlineCount === checked.length
    ? { tone: 'ok', text: t.allOperational }
    : onlineCount === 0
      ? { tone: 'down', text: t.allDown }
      : { tone: 'warn', text: t.someDown(checked.length - onlineCount, checked.length) };

const checkedAtLabel = `${new Intl.DateTimeFormat(htmlLang[locale], {
  dateStyle: 'short',
  timeStyle: 'medium',
  timeZone: 'UTC',
}).format(new Date(checkedAt))} UTC`;
---

<Layout
  locale={locale}
  title="unicep status"
  description={t.description}
  alternates={routes.status}
  current="status"
  refreshSeconds={60}
>
  <section class="hero">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{t.heading}</h1>
    <p class={`summary pulse ${summary.tone}`}>
      <span class="dot" aria-hidden="true"></span>
      {summary.text}
    </p>
  </section>

  <section class="grid" aria-label={t.heading}>
    {
      providers.map((provider) => (
        <a
          class="card"
          href={provider.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${provider.name} (${t.openInNewTab})`}
        >
          <div class="card-head">
            <div class="card-title">
              <h2>{provider.name}</h2>
              {provider.requiresKey && <span class="tag">{t.keyRequired}</span>}
            </div>
            {provider.checked ? (
              <span class={`badge pulse ${provider.online ? 'ok' : 'down'}`}>
                <span class="dot" aria-hidden="true" />
                {provider.online ? t.online : t.offline}
              </span>
            ) : (
              <span class="badge neutral">{t.notChecked}</span>
            )}
          </div>
          <dl>
            <div>
              <dt>{t.latency}</dt>
              <dd class="mono">{provider.latencyMs === null ? '—' : `${provider.latencyMs} ms`}</dd>
            </div>
            <div>
              <dt>{t.circuitBreaker}</dt>
              <dd>
                {provider.checked ? (
                  <span
                    class={`circuit ${provider.circuit === 'closed' ? 'ok' : provider.circuit === 'open' ? 'down' : 'warn'}`}
                  >
                    {t.circuit[provider.circuit]}
                  </span>
                ) : (
                  '—'
                )}
              </dd>
            </div>
          </dl>
        </a>
      ))
    }
  </section>

  <p class="checked">
    {t.lastChecked} <time datetime={checkedAt}>{checkedAtLabel}</time>
  </p>
</Layout>

<style is:global>
  .hero {
    margin-bottom: 40px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--muted);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 0 0 20px;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  /* Status tones: --tone is an "r, g, b" triplet used for the glow and the pulse. */
  .ok {
    --tone: 61, 220, 151;
    color: var(--ok);
    background: var(--ok-bg);
  }
  .warn {
    --tone: 245, 185, 66;
    color: var(--warn);
    background: var(--warn-bg);
  }
  .down {
    --tone: 255, 107, 107;
    color: var(--down);
    background: var(--down-bg);
  }

  .summary,
  .badge,
  .circuit {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    font-weight: 500;
  }

  .summary {
    margin: 0;
    padding: 6px 14px;
    font-size: 0.9rem;
  }

  .badge,
  .circuit {
    padding: 2px 10px;
    font-size: 0.78rem;
  }

  /* Soft glow around the badge plus a ring that pulses outwards. */
  .pulse {
    box-shadow: 0 0 6px rgba(var(--tone), 0.04);
  }

  .pulse::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    animation: pulse 3.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(var(--tone), 0);
    }
    50% {
      box-shadow: 0 0 0 3px rgba(var(--tone), 0.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse::before {
      animation: none;
    }
  }

  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  .grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }

  .card {
    display: block;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s,
      background 0.15s;
  }

  .card:hover,
  .card:focus-visible {
    border-color: var(--border-hover);
    background: var(--surface-hover);
  }

  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
  }

  .card h2 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  dl {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  dl > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  dt {
    color: var(--muted);
    font-size: 0.875rem;
  }

  dd {
    margin: 0;
    font-weight: 500;
  }

  .mono {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-variant-numeric: tabular-nums;
  }

  .card-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }

  /* Marks a provider that needs an API key. */
  .tag {
    padding: 1px 8px;
    border: 1px solid var(--border-hover);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .badge.neutral {
    padding: 2px 10px;
    border-radius: 999px;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.06);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .checked {
    margin: 32px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
