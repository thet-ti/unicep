---
import { messages, type Locale } from '../i18n/ui';
import { repositoryUrl, thetUrl } from '../lib/site';

interface Props {
  locale: Locale;
}

const t = messages[Astro.props.locale];
---

<footer class="site-footer">
  <div class="foot">
    <a class="thet" href={thetUrl} rel="noopener noreferrer" aria-label=".thet">
      <img src="/thet-logo.png" alt=".thet" width="214" height="82" />
    </a>
    <p class="motd">{t.motd}</p>
    <p class="legal">
      <a href={repositoryUrl} rel="noopener noreferrer">MIT Open Source</a>
    </p>
  </div>
</footer>

<style is:global>
  .site-footer {
    border-top: 1px solid var(--border);
  }

  .site-footer .foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    max-width: 960px;
    margin: 0 auto;
    padding: 40px 20px;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer img {
    display: block;
    width: auto;
    height: 24px;
  }

  .site-footer a.thet {
    display: block;
    opacity: 0.9;
    transition: opacity 0.15s;
  }

  .site-footer a.thet:hover {
    opacity: 1;
  }

  .site-footer .motd {
    color: var(--text);
  }

  .site-footer .legal {
    font-size: 0.78rem;
    opacity: 0.7;
  }

  .site-footer .legal a {
    color: var(--text);
    text-decoration: none;
  }
  .site-footer .legal a:hover {
    text-decoration: underline;
  }
</style>
