---
import { messages, type Locale } from '../i18n/ui';
import { npmUrl, repositoryUrl, version } from '../lib/site';

interface Props {
  locale: Locale;
}

const t = messages[Astro.props.locale];
---

<a class="icon-link" href={repositoryUrl} rel="noopener noreferrer" aria-label={t.github}>
  <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
    <path
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
    ></path>
  </svg>
</a>
<a class="icon-link" href={npmUrl} rel="noopener noreferrer" aria-label={t.npm(version)}>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
    <path
      d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"
    ></path>
  </svg>
  <span class="version">v{version}</span>
</a>

<style is:global>
  .icon-link {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 8px;
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
    transition:
      color 0.15s,
      background 0.15s;
  }

  .icon-link svg {
    display: block;
    flex: none;
  }

  .icon-link:hover,
  .icon-link:focus-visible {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
  }

  .icon-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .icon-link .version {
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1;
  }
</style>
