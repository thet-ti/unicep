---
import ExternalLinks from '../components/ExternalLinks.astro';
import { messages, routes } from '../i18n/ui';
import { localeFromLang } from '../lib/locale';

const locale = localeFromLang(Astro.locals.starlightRoute.lang);
const t = messages[locale];
---

<div class="docs-links">
  <a class="status-link" href={routes.status[locale]}>{t.nav.status}</a>
  <ExternalLinks locale={locale} />
</div>

<style is:global>
  .docs-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .docs-links .status-link {
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 12px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 0.15s,
      background 0.15s;
  }

  .docs-links .status-link:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
  }
</style>
