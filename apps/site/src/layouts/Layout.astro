---
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import Brand from '../components/Brand.astro';
import ExternalLinks from '../components/ExternalLinks.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
  defaultLocale,
  htmlLang,
  languageNames,
  type Locale,
  locales,
  messages,
  type RouteName,
  routes,
} from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Page equivalents in every locale, for the language switcher. */
  alternates: Record<Locale, string>;
  /** Highlights the matching navigation link. */
  current?: RouteName;
  /** Seconds between automatic reloads; omit to disable. */
  refreshSeconds?: number;
  /** Structured data (schema.org) serialized as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const { locale, title, description, alternates, current, refreshSeconds, jsonLd } = Astro.props;
const t = messages[locale];
const ogLocale: Record<Locale, string> = { 'pt-br': 'pt_BR', en: 'en_US' };
const absolute =(path: string) => new URL(path, Astro.site).href;
const canonical = absolute(alternates[locale]);
const ogImage = absolute('/thet-logo.png');
// "<" is escaped so the payload can never close the script tag.
const jsonLdText = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const nav: { name: RouteName; label: string }[] = [
  { name: 'docs', label: t.nav.docs },
  { name: 'status', label: t.nav.status },
];
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    {refreshSeconds && <meta http-equiv="refresh" content={String(refreshSeconds)} />}
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {
      locales.map((code) => (
        <link rel="alternate" hreflang={htmlLang[code]} href={absolute(alternates[code])} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absolute(alternates[defaultLocale])} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="unicep" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {
      locales
        .filter((code) => code !== locale)
        .map((code) => (
          <meta property="og:locale:alternate" content={ogLocale[code]} />
        ))
    }
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <Brand href={routes.home[locale]} />

        <nav class="links" aria-label="Main">
          <div class="main-nav">
            {
              nav.map((item) => (
                <a
                  href={routes[item.name][locale]}
                  aria-current={item.name === current ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </div>

          <div class="lang" role="group" aria-label={t.language}>
            {
              locales.map((code) => (
                <a
                  href={alternates[code]}
                  hreflang={htmlLang[code]}
                  lang={htmlLang[code]}
                  aria-label={languageNames[code].full}
                  aria-current={code === locale ? 'true' : undefined}
                >
                  {languageNames[code].short}
                </a>
              ))
            }
          </div>

          <ExternalLinks locale={locale} />
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <SiteFooter locale={locale} />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
  }

  body {
    min-height: 100vh;
    margin: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-feature-settings: 'cv11', 'ss01';
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  .container {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 20px;
  }

  main.container {
    position: relative;
    flex: 1;
    padding-top: 72px;
    padding-bottom: 72px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border);
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(12px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-right: 8px;
  }

  .main-nav a {
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 12px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 0.15s,
      background 0.15s;
  }

  .main-nav a:hover,
  .main-nav a[aria-current='page'] {
    color: var(--text);
  }

  .main-nav a[aria-current='page'] {
    background: rgba(255, 255, 255, 0.08);
  }

  .lang {
    display: flex;
    align-items: center;
    height: 36px;
    margin-right: 8px;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .lang a {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 10px;
    border-radius: 6px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      color 0.15s,
      background 0.15s;
  }

  .lang a:hover {
    color: var(--text);
  }

  .lang a[aria-current='true'] {
    color: var(--text);
    background: rgba(255, 255, 255, 0.1);
  }

  .main-nav a:focus-visible,
  .lang a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 560px) {
    .icon-link .version {
      display: none;
    }
  }
</style>
