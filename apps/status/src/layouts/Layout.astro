---
import '@fontsource-variable/inter';
import corePackage from '@unicep/core/package.json';

interface Props {
  title: string;
  description: string;
  /** Seconds between automatic reloads; omit to disable. */
  refreshSeconds?: number;
}

const { title, description, refreshSeconds } = Astro.props;

// The status page runs the exact @unicep/core version from this repository.
const version: string = corePackage.version;
const repositoryUrl = 'https://github.com/thet-ti/unicep';
const npmUrl = `https://www.npmjs.com/package/@unicep/core/v/${version}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    {refreshSeconds && <meta http-equiv="refresh" content={String(refreshSeconds)} />}
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/" aria-label="unicep status">
          <span class="brand-dot" aria-hidden="true"></span>
          <span class="brand-name">unicep</span>
        </a>

        <nav class="links" aria-label="Project links">
          <a class="icon-link" href={repositoryUrl} rel="noopener noreferrer" aria-label="unicep on GitHub">
            <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
          </a>
          <a
            class="icon-link npm"
            href={npmUrl}
            rel="noopener noreferrer"
            aria-label={`@unicep/core ${version} on npm`}
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path
                d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z"
              ></path>
            </svg>
            <span class="version">v{version}</span>
          </a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot">
        <img src="/thet-logo.png" alt=".thet" width="214" height="82" />
        <p>Brazilian CEP lookup with automatic provider fallback.</p>
        <p class="legal">
          <a href={repositoryUrl} rel="noopener noreferrer">Open source</a> under the MIT license.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    /* .thet identity: black canvas, white type, magenta accent. */
    --bg: #000000;
    --surface: #0a0a0a;
    --surface-hover: #111111;
    --border: #1f1f1f;
    --border-hover: #333333;
    --text: #fafafa;
    --muted: #a1a1a1;
    --accent: #e52a9a;
    --accent-bright: #ff03f2;
    --ok: #3ddc97;
    --ok-bg: rgba(61, 220, 151, 0.1);
    --warn: #f5b942;
    --warn-bg: rgba(245, 185, 66, 0.1);
    --down: #ff6b6b;
    --down-bg: rgba(255, 107, 107, 0.1);
    --radius: 12px;
    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
  }

  body {
    min-height: 100vh;
    margin: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-feature-settings: 'cv11', 'ss01';
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  .container {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 20px;
  }

  main.container {
    position: relative;
    flex: 1;
    padding-top: 72px;
    padding-bottom: 72px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border);
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(12px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* Same size as the lowercase letters (1ex = x-height), sitting on the baseline. */
  .brand-dot {
    display: inline-block;
    width: 1ex;
    height: 1ex;
    margin-right: 0.18em;
    border-radius: 0.14ex;
    background: linear-gradient(135deg, #ec13ca, var(--accent-bright));
  }

  .links {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    border-radius: 8px;
    color: var(--muted);
    text-decoration: none;
    transition:
      color 0.15s,
      background 0.15s;
  }

  .icon-link:hover,
  .icon-link:focus-visible {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
  }

  .icon-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .icon-link.npm {
    padding-right: 12px;
  }

  .version {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
  }

  .site-footer {
    border-top: 1px solid var(--border);
  }

  .foot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding-top: 40px;
    padding-bottom: 40px;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .foot p {
    margin: 0;
  }

  .foot img {
    display: block;
    width: auto;
    height: 24px;
  }

  .foot a {
    color: var(--text);
    text-decoration: none;
  }
  .foot a:hover {
    text-decoration: underline;
  }

  .legal {
    font-size: 0.78rem;
    opacity: 0.7;
  }
</style>
