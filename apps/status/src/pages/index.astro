---
import Layout from '../layouts/Layout.astro';
import { getStatus } from '../lib/status';

const { providers, checkedAt } = await getStatus();

const onlineCount = providers.filter((p) => p.online).length;
const summary =
  onlineCount === providers.length
    ? { tone: 'ok', text: 'All providers are operational' }
    : onlineCount === 0
      ? { tone: 'down', text: 'All providers are down' }
      : { tone: 'warn', text: `${providers.length - onlineCount} of ${providers.length} providers are down` };

const circuitLabel = { closed: 'Closed', open: 'Open', 'half-open': 'Half-open' } as const;
const checkedAtLabel = new Date(checkedAt).toISOString().replace('T', ' ').slice(0, 19) + ' UTC';

// Shared between visitors; the server also caches the snapshot for 60 seconds.
Astro.response.headers.set('Cache-Control', 'public, max-age=30, s-maxage=60');
---

<Layout
  title="unicep status"
  description="Live status of the CEP providers used by unicep."
  refreshSeconds={60}
>
  <section class="hero">
    <p class="eyebrow">Status</p>
    <h1>Provider status</h1>
    <p class={`summary ${summary.tone}`}>
      <span class="dot" aria-hidden="true"></span>
      {summary.text}
    </p>
  </section>

  <section class="grid" aria-label="Providers">
    {
      providers.map((provider) => (
        <article class="card">
          <div class="card-head">
            <h2>
              <a href={provider.url} rel="noopener noreferrer">{provider.name}</a>
            </h2>
            <span class={`badge ${provider.online ? 'ok' : 'down'}`}>
              <span class="dot" aria-hidden="true" />
              {provider.online ? 'Online' : 'Offline'}
            </span>
          </div>
          <dl>
            <div>
              <dt>Latency</dt>
              <dd class="mono">{provider.latencyMs === null ? '—' : `${provider.latencyMs} ms`}</dd>
            </div>
            <div>
              <dt>Circuit breaker</dt>
              <dd>
                <span class={`circuit ${provider.circuit}`}>{circuitLabel[provider.circuit]}</span>
              </dd>
            </div>
          </dl>
        </article>
      ))
    }
  </section>

  <p class="checked">
    Last checked <time datetime={checkedAt}>{checkedAtLabel}</time>. Results are shared between visitors
    and refreshed every minute.
  </p>
</Layout>

<style is:global>
  .hero {
    margin-bottom: 40px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--accent);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 0 0 20px;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .summary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .summary.ok {
    color: var(--ok);
    background: var(--ok-bg);
  }
  .summary.warn {
    color: var(--warn);
    background: var(--warn-bg);
  }
  .summary.down {
    color: var(--down);
    background: var(--down-bg);
  }

  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  .grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }

  .card {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      border-color 0.15s,
      background 0.15s;
  }

  .card:hover {
    border-color: rgba(229, 42, 154, 0.5);
    background: var(--surface-hover);
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
  }

  .card h2 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .card h2 a {
    text-decoration: none;
  }
  .card h2 a:hover {
    color: var(--accent);
  }

  .badge,
  .circuit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 500;
  }

  .badge.ok,
  .circuit.closed {
    color: var(--ok);
    background: var(--ok-bg);
  }
  .badge.down,
  .circuit.open {
    color: var(--down);
    background: var(--down-bg);
  }
  .circuit.half-open {
    color: var(--warn);
    background: var(--warn-bg);
  }

  dl {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  dl > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  dt {
    color: var(--muted);
    font-size: 0.875rem;
  }

  dd {
    margin: 0;
    font-weight: 500;
  }

  .mono {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-variant-numeric: tabular-nums;
  }

  .checked {
    margin: 32px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
