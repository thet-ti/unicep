---
import { getStatus } from '../lib/status';

const { providers, checkedAt } = await getStatus();

const onlineCount = providers.filter((p) => p.online).length;
const summary =
  onlineCount === providers.length
    ? { tone: 'ok', text: 'All providers are operational' }
    : onlineCount === 0
      ? { tone: 'down', text: 'All providers are down' }
      : {
          tone: 'warn',
          text: `${providers.length - onlineCount} of ${providers.length} providers are down`,
        };

const circuitLabel = { closed: 'Closed', open: 'Open', 'half-open': 'Half-open' } as const;
const checkedAtLabel = new Date(checkedAt).toISOString().replace('T', ' ').slice(0, 19) + ' UTC';

// Shared between visitors; the server also caches the snapshot for 60 seconds.
Astro.response.headers.set('Cache-Control', 'public, max-age=30, s-maxage=60');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="60" />
    <meta name="description" content="Live status of the CEP providers used by unicep." />
    <title>unicep status</title>
  </head>
  <body>
    <main>
      <header>
        <h1>unicep status</h1>
        <p class={`summary ${summary.tone}`}>
          <span class="dot" aria-hidden="true"></span>
          {summary.text}
        </p>
      </header>

      <section class="grid" aria-label="Providers">
        {
          providers.map((provider) => (
            <article class="card">
              <div class="card-head">
                <h2>
                  <a href={provider.url} rel="noopener noreferrer">{provider.name}</a>
                </h2>
                <span class={`badge ${provider.online ? 'ok' : 'down'}`}>
                  {provider.online ? 'Online' : 'Offline'}
                </span>
              </div>
              <dl>
                <div>
                  <dt>Latency</dt>
                  <dd>{provider.latencyMs === null ? '—' : `${provider.latencyMs} ms`}</dd>
                </div>
                <div>
                  <dt>Circuit breaker</dt>
                  <dd>
                    <span class={`circuit ${provider.circuit}`}>{circuitLabel[provider.circuit]}</span>
                  </dd>
                </div>
              </dl>
            </article>
          ))
        }
      </section>

      <footer>
        <p>
          Last checked <time datetime={checkedAt}>{checkedAtLabel}</time>. Results are shared between
          visitors and refreshed every minute.
        </p>
        <p>
          <a href="https://github.com/thet-ti/unicep">unicep</a> · Brazilian CEP lookup with automatic
          provider fallback.
        </p>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f7f9;
    --surface: #ffffff;
    --border: #e1e4e8;
    --text: #1b1f24;
    --muted: #5b6573;
    --ok: #1a7f4b;
    --ok-bg: #e3f5ec;
    --warn: #9a6700;
    --warn-bg: #fff4d6;
    --down: #c4261d;
    --down-bg: #fde8e6;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1216;
      --surface: #171b21;
      --border: #2a3039;
      --text: #e8ebef;
      --muted: #9aa4b2;
      --ok: #4cc38a;
      --ok-bg: #12301f;
      --warn: #e3b341;
      --warn-bg: #33290d;
      --down: #ff7b72;
      --down-bg: #3a1614;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.5;
  }

  main {
    max-width: 880px;
    margin: 0 auto;
    padding: 48px 16px;
  }

  h1 {
    margin: 0 0 12px;
    font-size: 1.75rem;
  }

  a {
    color: inherit;
  }

  .summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 32px;
    padding: 8px 14px;
    border-radius: 999px;
    font-weight: 600;
  }

  .summary .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: currentColor;
  }

  .summary.ok {
    color: var(--ok);
    background: var(--ok-bg);
  }
  .summary.warn {
    color: var(--warn);
    background: var(--warn-bg);
  }
  .summary.down {
    color: var(--down);
    background: var(--down-bg);
  }

  .grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }

  .card {
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .card h2 {
    margin: 0;
    font-size: 1.1rem;
  }

  .card h2 a {
    text-decoration: none;
  }
  .card h2 a:hover {
    text-decoration: underline;
  }

  .badge,
  .circuit {
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .badge.ok,
  .circuit.closed {
    color: var(--ok);
    background: var(--ok-bg);
  }
  .badge.down,
  .circuit.open {
    color: var(--down);
    background: var(--down-bg);
  }
  .circuit.half-open {
    color: var(--warn);
    background: var(--warn-bg);
  }

  dl {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  dl > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  dt {
    color: var(--muted);
    font-size: 0.9rem;
  }

  dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  footer {
    margin-top: 40px;
    color: var(--muted);
    font-size: 0.85rem;
  }

  footer p {
    margin: 4px 0;
  }
</style>
