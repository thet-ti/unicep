{
  "name": "@unicep/react",
  "version": "0.2.0",
  "description": "React hook for @unicep/core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thet-ti/unicep.git",
    "directory": "packages/react"
  },
  "homepage": "https://unicep.thet.dev",
  "bugs": {
    "url": "https://github.com/thet-ti/unicep/issues"
  },
  "keywords": [
    "cep",
    "brazil",
    "postal-code",
    "viacep",
    "brasilapi",
    "circuit-breaker",
    "fallback",
    "cep-lookup",
    "consulta-cep",
    "zip-code",
    "address",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack . --profile node16"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@unicep/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "vitest": "^5.1.1"
  }
}
