{
  "name": "@unicep/angular",
  "version": "0.1.1",
  "description": "Angular (signals and RxJS) bindings for @unicep/core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thet-ti/unicep.git",
    "directory": "packages/angular"
  },
  "homepage": "https://unicep.thet.dev",
  "bugs": {
    "url": "https://github.com/thet-ti/unicep/issues"
  },
  "keywords": [
    "cep",
    "brazil",
    "postal-code",
    "viacep",
    "brasilapi",
    "circuit-breaker",
    "fallback"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack . --profile node16"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@unicep/core": "workspace:^"
  },
  "peerDependencies": {
    "@angular/core": ">=17.0.0",
    "rxjs": "^7.4.0"
  },
  "devDependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "^31.0.0",
    "rxjs": "^7.8.2",
    "tsup": "^9.0.0",
    "vitest": "^5.1.0"
  }
}
