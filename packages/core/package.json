{
  "name": "@unicep/core",
  "version": "0.0.0",
  "description": "Brazilian CEP lookup with automatic provider fallback and circuit breakers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thet-ti/unicep.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/thet-ti/unicep#readme",
  "bugs": {
    "url": "https://github.com/thet-ti/unicep/issues"
  },
  "keywords": [
    "cep",
    "brazil",
    "postal-code",
    "viacep",
    "brasilapi",
    "circuit-breaker",
    "fallback"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run -c vitest.live.config.ts",
    "check:package": "publint && attw --pack . --profile node16"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "tsup": "^9.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "cockatiel": "^4.0.0"
  }
}
